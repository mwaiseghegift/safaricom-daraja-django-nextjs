# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (optional - using SQLite by default)
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Safaricom Daraja API Credentials
# Get these from https://developer.safaricom.co.ke/

# Sandbox Credentials
DARAJA_ENVIRONMENT=sandbox  # Options: sandbox, production
DARAJA_CONSUMER_KEY=your_consumer_key_here
DARAJA_CONSUMER_SECRET=your_consumer_secret_here

# Business Short Codes
DARAJA_SHORTCODE=174379  # Your paybill/till number
DARAJA_TILL_NUMBER=174379  # For buy goods
DARAJA_PAYBILL=174379

# Initiator Credentials (for B2C, B2B, Reversals, etc.)
DARAJA_INITIATOR_NAME=testapi
DARAJA_INITIATOR_PASSWORD=Safaricom999!*!  # Plain text, will be encrypted in code
DARAJA_SECURITY_CREDENTIAL=  # Leave empty, generated from password

# STK Push (M-Pesa Express) Credentials
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Callback URLs (use ngrok/localtunnel for local development)
DARAJA_CALLBACK_BASE_URL=https://your-domain.com  # e.g., https://abc123.ngrok.io
DARAJA_STK_CALLBACK_URL=${DARAJA_CALLBACK_BASE_URL}/api/callback/stk/
DARAJA_B2C_CALLBACK_URL=${DARAJA_CALLBACK_BASE_URL}/api/callback/b2c/
DARAJA_B2B_CALLBACK_URL=${DARAJA_CALLBACK_BASE_URL}/api/callback/b2b/
DARAJA_C2B_VALIDATION_URL=${DARAJA_CALLBACK_BASE_URL}/api/callback/c2b/validation/
DARAJA_C2B_CONFIRMATION_URL=${DARAJA_CALLBACK_BASE_URL}/api/callback/c2b/confirmation/
DARAJA_REVERSAL_CALLBACK_URL=${DARAJA_CALLBACK_BASE_URL}/api/callback/reversal/
DARAJA_TRANSACTION_STATUS_CALLBACK_URL=${DARAJA_CALLBACK_BASE_URL}/api/callback/transaction-status/
DARAJA_ACCOUNT_BALANCE_CALLBACK_URL=${DARAJA_CALLBACK_BASE_URL}/api/callback/account-balance/

# API Timeouts and Retries
DARAJA_TIMEOUT=30  # seconds
DARAJA_TOKEN_CACHE_DURATION=3500  # seconds (tokens expire in 3600s)

# Production API URLs (automatically set based on DARAJA_ENVIRONMENT)
# DARAJA_BASE_URL=https://api.safaricom.co.ke  # Production
# DARAJA_BASE_URL=https://sandbox.safaricom.co.ke  # Sandbox (default)

# Logging Level
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# CORS Settings (for Next.js frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
